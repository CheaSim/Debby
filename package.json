{
  "name": "finpet",
  "version": "0.1.0",
  "description": "A local-first financial desktop companion",
  "main": "out/main/index.js",
  "author": "Debby contributors",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "predev": "node scripts/setup-avatar.mjs && node scripts/setup-dance.mjs",
    "dev": "electron-vite dev",
    "assets": "node scripts/generate-assets.mjs",
    "postinstall": "npm run assets",
    "prebuild": "node scripts/setup-avatar.mjs && node scripts/setup-dance.mjs",
    "build": "electron-vite build",
    "build:release": "node scripts/setup-avatar.mjs && node scripts/setup-dance.mjs && electron-vite build --mode release && node scripts/build-mcp.mjs",
    "preview": "electron-vite preview",
    "relay:demo": "node server/demo-relay.mjs",
    "mate-engine:setup": "node scripts/setup-mate-engine.mjs",
    "avatar:setup": "node scripts/setup-avatar.mjs",
    "avatar:decompose": "node integrations/see-through.mjs",
    "avatar:decompose:hosted": "node integrations/see-through-hosted.mjs",
    "avatar:rig": "node scripts/rig-whale-girl.mjs",
    "avatar:pack-expressions": "node scripts/pack-expression-avatar.mjs",
    "dance:setup": "node scripts/setup-dance.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && node tests/electron.e2e.mjs",
    "test:chat-ui": "npm run build && node tests/chat-ui.e2e.mjs",
    "test:voice-ui": "npm run build && node tests/voice-ui.e2e.mjs",
    "test:read-aloud-ui": "npm run build && node tests/read-aloud-ui.e2e.mjs",
    "test:tts-live": "npm run build && node scripts/verify-tts-live.mjs",
    "test:tts-styles-live": "npm run build && node scripts/verify-tts-styles-live.mjs",
    "test:speech-preview": "npm run build && node tests/speech-preview.e2e.mjs",
    "test:tts-stream-live": "npm run build && node scripts/verify-tts-stream-live.mjs",
    "test:agent-shell": "npm run build && node tests/agent-shell.e2e.mjs",
    "test:dance-ui": "npm run build && node tests/dance-ui.e2e.mjs",
    "test:discovery-ui": "npm run build && node tests/discovery-ui.e2e.mjs",
    "test:layered-avatar": "npm run build && node tests/layered-avatar.e2e.mjs",
    "test:decomposed-avatar": "npm run build && node tests/decomposed-avatar.e2e.mjs",
    "test:expression-avatar": "npm run build && node tests/expression-avatar.e2e.mjs",
    "test:expression-transition": "npm run build && node tests/expression-transition.e2e.mjs",
    "test:performance-ui": "npm run build && node tests/performance-ui.e2e.mjs",
    "test:standrig-avatar": "npm run build && node tests/standrig-avatar.e2e.mjs",
    "test:avatar-motion": "npm run build && node tests/avatar-motion.e2e.mjs",
    "test:avatar-skeleton": "npm run build && node tests/avatar-skeleton.e2e.mjs",
    "test:live": "npm run build && node scripts/verify-live.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "package:win": "npm run assets && npm run build:release && node scripts/check-release-assets.mjs && electron-builder --win nsis zip"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.0.4",
    "@earendil-works/pi-ai": "1.0.4",
    "@mediapipe/tasks-vision": "0.10.32",
    "@modelcontextprotocol/server": "2.3.1",
    "@pixi/unsafe-eval": "^6.5.10",
    "@pixiv/three-vrm": "^3.5.5",
    "@pixiv/three-vrm-animation": "3.5.5",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "5.1.4",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "latest",
    "pixi-live2d-display": "0.4.0",
    "pixi.js": "6.5.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.180.0",
    "typebox": "1.3.27",
    "ws": "latest",
    "zod": "4.6.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/ws": "latest",
    "electron": "^43.3.0",
    "electron-builder": "latest",
    "electron-vite": "^5.0.0",
    "esbuild": "0.25.12",
    "eslint": "latest",
    "playwright": "1.62.1",
    "png-to-ico": "3.0.2",
    "sharp": "0.35.3",
    "typescript": "latest",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  },
  "build": {
    "appId": "com.finpet.desktop",
    "productName": "Debby",
    "asar": true,
    "files": [
      "out/**/*",
      "!out/mcp/**/*",
      "!out/renderer/models/mate-engine/**/*",
      "!out/renderer/live2d/**/*",
      "!out/renderer/vendor/live2dcubismcore.min.js"
    ],
    "extraResources": [
      {
        "from": "build/tray.png",
        "to": "tray.png"
      },
      {
        "from": "out/mcp",
        "to": "mcp"
      },
      {
        "from": "RELEASE-NOTICES.md",
        "to": "RELEASE-NOTICES.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "perMachine": false,
      "allowElevation": false,
      "runAfterFinish": false
    },
    "afterPack": "./scripts/verify-release.mjs",
    "artifactName": "Debby-${version}-${arch}.${ext}"
  }
}
